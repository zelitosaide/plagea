# MongoDB connection string. Required in production — the app throws on boot if missing.
MONGODB_URI=mongodb://user:password@host:27017/dbname?authSource=admin

# Database name used within the MongoDB cluster above.
MONGODB_DB=plagea

# Secret used to sign session cookies (JWT). Required in production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Port the app listens on inside the container. Must match the port Nginx
# proxies to for this environment (see deploy/nginx-plagea.conf.template).
PORT=3000

# Name of the session cookie. Leave unset in production (defaults to
# "plagea_session"). When staging shares the same domain as production,
# distinguished only by an external port (no spare subdomain available —
# see docs/DEPLOYMENT.md section 4), set a DIFFERENT value here for
# staging (e.g. "plagea_staging_session") so the two environments never
# collide over the same cookie in a tester's browser.
# SESSION_COOKIE_NAME=plagea_staging_session

# Set automatically by deploy/deploy.sh on each deploy — do not set by hand
# in production/staging. Only relevant for local "docker compose" usage.
# APP_IMAGE=ghcr.io/zelitosaide/plagea:prod
# MIGRATE_IMAGE=ghcr.io/zelitosaide/plagea:prod-tools
